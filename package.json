{
  "name": "pi-primitive-receiver",
  "description": "Primitive mail receiving and idle wake for Pi-compatible coding agents (experimental)",
  "license": "MIT",
  "author": "jaeyunha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaeyunha/pi-primitive-receiver.git"
  },
  "homepage": "https://github.com/jaeyunha/pi-primitive-receiver#readme",
  "bugs": { "url": "https://github.com/jaeyunha/pi-primitive-receiver/issues" },
  "keywords": ["pi-package", "pi-extension", "primitive", "email"],
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "files": [
    "index.ts",
    "entry.ts",
    "session.ts",
    "configuration.ts",
    "schema.ts",
    "primitive.ts",
    "primitive-policy.d.ts",
    "queue.ts",
    "receiver.ts",
    "transport.ts",
    "pi.ts",
    "accept.mjs",
    "LICENSE",
    "README.md",
    "skills"
  ],
  "version": "0.2.0",
  "type": "module",
  "pi": { "extensions": ["./index.ts"], "skills": ["./skills"] },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "bun test",
    "verify:package": "bun scripts/verify-distribution.ts",
    "verify:live": "bun scripts/verify-live.ts"
  },
  "dependencies": {
    "primitive": "1.73.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "typebox": "1.3.27",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxfmt": "0.74.0"
  }
}
