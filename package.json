{
  "name": "pi-primitive-receiver",
  "private": true,
  "description": "Private Primitive mail receiving and idle wake for Pi-compatible harnesses",
  "license": "UNLICENSED",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22" },
  "files": [
    "index.ts",
    "entry.ts",
    "session.ts",
    "configuration.ts",
    "schema.ts",
    "primitive.ts",
    "primitive-policy.d.ts",
    "queue.ts",
    "receiver.ts",
    "transport.ts",
    "pi.ts",
    "accept.mjs",
    "README.md",
    "skills"
  ],
  "version": "0.1.0",
  "type": "module",
  "pi": { "extensions": ["./index.ts"], "skills": ["./skills"] },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "bun test",
    "verify:package": "bun scripts/verify-distribution.ts"
  },
  "dependencies": {
    "primitive": "1.73.0",
    "typebox": "1.3.27",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxfmt": "0.74.0"
  }
}
